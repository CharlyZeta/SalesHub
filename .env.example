# ---------------------------------------------------------------------------
# SalesHub - Variables de entorno (opcionales)
# ---------------------------------------------------------------------------
# Ninguna es obligatoria para usar la aplicación: los valores por defecto ya
# funcionan. Copiá este archivo como `.env` (o `.env.local`) y descomentá lo que
# necesites. Las variables VITE_* se exponen al cliente en el build.

# --- Datos de demostración ---------------------------------------------------
# true  = sembrar ventas, catálogo, presupuestos y clientes de ejemplo cuando la
#         base local (localStorage) está vacía.
# false = (por defecto) instalación nueva arranca VACÍA, sin datos de ejemplo.
VITE_SEED_DEMO=false

# Modo demo de WooCommerce: ante un fallo de la API, devuelve catálogo y clientes
# simulados (SOLO para demos sin conexión). Por defecto está desactivado: si la
# sincronización falla, el error se propaga en lugar de mostrar datos ficticios.
#VITE_WOO_DEMO=true

# --- Servidor de producción (server.js / npm start) --------------------------
# Puerto e interfaz de escucha.
#PORT=3000
#HOST=0.0.0.0
# Carpeta del build estático a servir (por defecto ./dist).
#DIST_DIR=dist
# Carpeta de datos del servidor: config/estado/snapshot de WooCommerce (excluida de git).
#DATA_DIR=data

# --- Sincronización programada de WooCommerce (W2 / Fix E) -------------------
# Cada cuántos milisegundos el servidor evalúa si corresponde sincronizar (default 60000).
#WOO_TICK_MS=60000
# off = desactiva la programación del servidor (queda solo el modo navegador).
#WOO_SCHEDULER=on

# --- Retención de copias de seguridad en disco ------------------------------
# Máximo de backups a conservar (0 = sin rotación, nunca borra nada).
#BACKUP_MAX_FILES=30
# Nunca eliminar copias más nuevas que esta cantidad de días.
#BACKUP_MIN_AGE_DAYS=7

# ---------------------------------------------------------------------------
# NOTA: las credenciales de WooCommerce (consumer key/secret) y el HASH de
# Andreani NO se configuran por entorno: se cargan desde la aplicación
# (Configuración → General & Ventas / WooCommerce) y quedan en el navegador.
# Por eso este archivo no contiene secretos.
# ---------------------------------------------------------------------------
