{
  "name": "saleshub",
  "private": true,
  "version": "1.0.0",
  "description": "SalesHub - Sistema integral de gestión comercial (ventas, presupuestos, remitos y omnicanalidad).",
  "author": "Gerardo Maidana <gerardomaidana@outlook.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:stable": "cross-env DISABLE_HMR=true vite --port=3000 --host=0.0.0.0",
    "stable": "npm run build && node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "map": "node scripts/generate-code-map.mjs",
    "map:check": "node scripts/generate-code-map.mjs --check",
    "graph:doctor": "node scripts/graph-doctor.mjs",
    "sdd:check": "node scripts/check-sdd-version.mjs",
    "deps:circular": "madge --circular --extensions ts,tsx src",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
